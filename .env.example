# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
PUBLIC_BASE_URL=https://stemora.example.com
WEB_PORT=8080

# Cloudflare R2 (private bucket). Endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stemora

# Modal web endpoint from `modal deploy worker/app.py` and the secret in Modal secret `stemora-auth`
MODAL_ENDPOINT_URL=
MODAL_SHARED_SECRET=
# openssl rand -hex 32  (backend only; the worker never sees this)
WEBHOOK_SIGNING_KEY=

MAX_UPLOAD_MB=200
MAX_DURATION_S=900
USER_QUOTA_MB=5000
MAX_CONCURRENT_JOBS=2
