# Postgres
DATABASE_URL=postgres://stemora:stemora@localhost:5432/stemora

# Public origin of the app (used for invite links, webhook callback URLs, cookie Secure flag).
# Modal must be able to reach PUBLIC_BASE_URL + /api/webhooks/jobs/{id}.
PUBLIC_BASE_URL=http://localhost:8080
BIND_ADDR=0.0.0.0:8080

# Cloudflare R2 (private bucket)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stemora
R2_REGION=auto

# Modal worker (leave MODAL_ENDPOINT_URL empty to accept uploads but fail jobs with a clear error)
MODAL_ENDPOINT_URL=
MODAL_SHARED_SECRET=

# HMAC key for per-job webhook tokens, >= 16 chars, e.g. `openssl rand -hex 32`
WEBHOOK_SIGNING_KEY=

# Limits
MAX_UPLOAD_MB=200
MAX_DURATION_S=900
USER_QUOTA_MB=5000
MAX_CONCURRENT_JOBS=2

# Optional: force the Secure cookie flag on/off (default: on when PUBLIC_BASE_URL is https)
# COOKIE_SECURE=true
# Optional: LOG_FORMAT=json, RUST_LOG=info
